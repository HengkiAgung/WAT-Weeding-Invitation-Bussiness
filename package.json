{
  "name": "wat-wedding-invitation",
  "private": true,
  "type": "module",
  "scripts": {
    "schema:export": "node --experimental-strip-types --no-warnings templates/_core/scripts/export-schema.ts",
    "schema:check": "node --experimental-strip-types --no-warnings templates/_core/scripts/check-fixtures.ts",
    "build:templates": "node tools/build_template.mjs --all",
