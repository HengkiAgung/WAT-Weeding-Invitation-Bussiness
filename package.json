  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "zod": "4.1.12"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "javascript-obfuscator": "5.8.0"
  }
}
