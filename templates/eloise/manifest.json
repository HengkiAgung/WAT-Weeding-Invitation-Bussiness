{
  "$schemaVersion": 1,
  "id": "eloise",
  "name": "Eloise",
  "version": "1.0.0",
  "category": "rustic",
  "tags": ["botanical", "envelope", "polaroid", "split-screen"],
  "description": {
    "id": "Amplop botani dengan segel lilin, polaroid, dan foto acara berbentuk lengkung. Nuansa rustic hangat.",
    "en": "Botanical envelope with wax seal, polaroids and arch-framed event photos. Warm rustic mood."
  },
  "supportsPhotoless": true,
  "languages": ["id", "en"],
  "entry": "index.html",
  "styles": ["css/style.css"],
  "scripts": ["js/eloise.js"],
  "sections": [
    { "id": "cover" },
    { "id": "hero" },
    { "id": "verse" },
    { "id": "opening" },
    { "id": "couple" },
    { "id": "story" },
    { "id": "countdown" },
    { "id": "events" },
    { "id": "live" },
    { "id": "rundown" },
    { "id": "rsvp" },
    { "id": "qrTicket" },
    { "id": "gallery" },
    { "id": "video" },
    { "id": "igFilter" },
    { "id": "gift" },
    { "id": "wishes" },
    { "id": "turutMengundang" },
    { "id": "dresscode" },
    { "id": "protocol" },
    { "id": "closing" },
    { "id": "footer" }
  ],
  "defaultVariant": "olive",
  "variants": [
    { "id": "olive", "name": "Olive & Cream", "css": "variants/olive.css", "swatch": ["#353a20", "#f6eed7", "#d9b680"], "ornaments": null },
    {
      "id": "sage", "name": "Sage Botanical", "css": "variants/sage.css", "swatch": ["#44533f", "#eef0e8", "#c9a96e"],
      "ornaments": { "rules": [{ "hue": [50, 130], "to": 95, "sat": 0.55, "light": 0.06 }] }
    },
    {
      "id": "dusty-rose", "name": "Dusty Rose", "css": "variants/dusty-rose.css", "swatch": ["#6b3f4a", "#f6e6e3", "#c9a27e"],
      "ornaments": { "rules": [{ "hue": [50, 130], "to": 345, "sat": 0.5, "light": 0.04 }] }
    },
    {
      "id": "latte", "name": "Latte & Gold", "css": "variants/latte.css", "swatch": ["#5a4332", "#f3e9dc", "#c8a165"],
      "ornaments": { "rules": [{ "hue": [50, 130], "to": 28, "sat": 0.6, "light": 0.0 }] }
    }
  ],
  "ornaments": { "source": "assets/svg/", "generated": "assets/ornaments/{variant}/" },
  "fonts": [
    { "family": "Pinyon Script", "source": "Google Fonts", "license": "OFL-1.1" },
    { "family": "Instrument Serif", "source": "Google Fonts", "license": "OFL-1.1" }
  ],
  "libs": [
    { "name": "GSAP (+ScrollTrigger, Observer)", "version": "3.12.5", "license": "GSAP Standard License (free incl. commercial)" },
    { "name": "AOS", "version": "2.3.4", "license": "MIT" },
    { "name": "tsParticles", "version": "3.9.1", "license": "MIT" },
    { "name": "Swiper", "version": "12.2.0", "license": "MIT" },
    { "name": "GLightbox", "version": "3.3.1", "license": "MIT" },
    { "name": "qrcode-generator", "version": "1.4.4", "license": "MIT" },
    { "name": "html2canvas", "version": "1.4.1", "license": "MIT", "lazy": true },
    { "name": "Phosphor Icons", "version": "2.1.1", "license": "MIT" }
  ],
  "limits": { "gallery": 40, "story": 6, "events": 4, "coverImages": 3 },
  "previewImages": [],
  "extraFields": {}
}
