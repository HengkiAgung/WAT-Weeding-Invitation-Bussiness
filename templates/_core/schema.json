{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "GENERATED from templates/_core/schema.ts — do not edit. npm run schema:export",
  "$defs": {
    "InvitationData": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "default": 1,
          "type": "number",
          "const": 1
        },
        "lang": {
          "default": "id",
          "type": "string",
          "enum": [
            "id",
            "en"
          ]
        },
        "religion": {
          "default": "umum",
          "type": "string",
          "enum": [
            "islam",
            "kristen",
            "katolik",
            "hindu",
            "buddha",
            "konghucu",
            "umum"
          ]
        },
        "photoless": {
          "default": false,
          "type": "boolean"
        },
        "coupleOrder": {
          "default": "groom_first",
          "type": "string",
          "enum": [
            "groom_first",
            "bride_first"
          ]
        },
        "groom": {
          "type": "object",
          "properties": {
            "fullName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "nickname": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            },
            "childOrder": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                {
                  "type": "string",
                  "enum": [
                    "bungsu",
                    "tunggal"
                  ]
                }
              ]
            },
            "father": {
              "type": "string",
              "maxLength": 80
            },
            "mother": {
              "type": "string",
              "maxLength": 80
            },
            "parentsText": {
              "type": "string",
              "maxLength": 200
            },
            "instagram": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._]{1,30}$"
            },
            "photo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "fullName",
            "nickname"
          ]
        },
        "bride": {
          "type": "object",
          "properties": {
            "fullName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "nickname": {
              "type": "string",
              "minLength": 1,
              "maxLength": 30
            },
            "childOrder": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                {
                  "type": "string",
                  "enum": [
                    "bungsu",
                    "tunggal"
                  ]
                }
              ]
            },
            "father": {
              "type": "string",
              "maxLength": 80
            },
            "mother": {
              "type": "string",
              "maxLength": 80
            },
            "parentsText": {
              "type": "string",
              "maxLength": 200
            },
            "instagram": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._]{1,30}$"
            },
            "photo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "fullName",
            "nickname"
          ]
        },
        "hashtag": {
          "type": "string",
          "pattern": "^#?[\\p{L}\\p{N}_]{1,40}$"
        },
        "events": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_-]{1,24}$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "akad",
                  "pemberkatan",
                  "pawiwahan",
                  "resepsi",
                  "siraman",
                  "midodareni",
                  "mappacci",
                  "ngunduh_mantu",
                  "sangjit",
                  "tea_pai",
                  "lainnya"
                ]
              },
              "title": {
                "type": "string",
                "maxLength": 60
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "timeStart": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "timeEnd": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "tz": {
                "default": "WIB",
                "type": "string",
                "enum": [
                  "WIB",
                  "WITA",
                  "WIT"
                ]
              },
              "venue": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "address": {
                "type": "string",
                "maxLength": 250
              },
              "mapUrl": {
                "type": "string",
                "maxLength": 500,
                "format": "uri"
              },
              "photo": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "guestGroups": {
                "default": [],
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[\\p{L}\\p{N} _-]{1,30}$"
                }
              }
            },
            "required": [
              "type",
              "date",
              "timeStart",
              "venue"
            ]
          }
        },
        "opening": {
          "default": {},
          "type": "object",
          "properties": {
            "greeting": {
              "type": "string",
              "maxLength": 120
            },
            "text": {
              "type": "string",
              "maxLength": 600
            }
          }
        },
        "verse": {
          "default": {},
          "type": "object",
          "properties": {
            "preset": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,40}$"
            },
            "text": {
              "type": "string",
              "maxLength": 800
            },
            "source": {
              "type": "string",
              "maxLength": 80
            }
          }
        },
        "closing": {
          "default": {},
          "type": "object",
          "properties": {
            "greeting": {
              "type": "string",
              "maxLength": 120
            },
            "text": {
              "type": "string",
              "maxLength": 600
            },
            "familyNames": {
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "story": {
          "default": [],
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "maxLength": 40
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "text": {
                "type": "string",
                "maxLength": 600
              },
              "photo": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "title",
              "text"
            ]
          }
        },
        "gallery": {
          "default": [],
          "maxItems": 60,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "video": {
          "type": "object",
          "properties": {
            "youtubeId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{11}$"
            },
            "src": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "poster": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        "live": {
          "type": "object",
          "properties": {
            "platform": {
              "type": "string",
              "maxLength": 30
