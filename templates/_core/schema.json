            "url": {
              "type": "string",
              "maxLength": 500,
              "format": "uri"
            },
            "schedule": {
              "type": "string",
              "maxLength": 80
            }
          },
          "required": [
            "url"
          ]
        },
        "rundown": {
          "default": [],
          "maxItems": 24,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "time": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
