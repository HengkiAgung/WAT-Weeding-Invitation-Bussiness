          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "url": {
              "type": "string",
              "maxLength": 500,
              "format": "uri"
            }
          },
          "required": [
            "name"
          ]
        }
      },
      "required": [
        "mode"
      ]
    }
  }
