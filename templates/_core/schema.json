          }
        },
        "protocol": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 600
            }
          }
        },
        "music": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
