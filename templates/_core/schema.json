            "autoplay": {
              "default": true,
              "type": "boolean"
            },
            "title": {
              "type": "string",
              "maxLength": 80
            }
          },
          "required": [
            "src"
          ]
        },
        "images": {
          "default": {},
          "type": "object",
          "properties": {
            "cover": {
              "default": [],
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "hero": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "couple": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "background": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "closing": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        "copy": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.]{1,60}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 300
          }
        }
      },
      "required": [
        "groom",
        "bride",
        "events"
      ]
    },
    "Guest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{4,16}$"
        },
        "group": {
          "type": "string",
          "pattern": "^[\\p{L}\\p{N} _-]{1,30}$"
        },
        "maxPax": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+?[0-9]{8,15}$"
        }
      },
      "required": [
        "name",
        "code"
      ]
    },
    "Theme": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "variant": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,30}$"
        },
        "ornamentBase": {
          "type": "string",
          "maxLength": 200
        },
        "tokens": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^--[a-z0-9-]{1,40}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 60
          }
        }
      },
      "required": [
        "variant"
