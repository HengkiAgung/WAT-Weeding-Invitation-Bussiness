                "phone": {
                  "type": "string",
                  "maxLength": 30
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "required": [
                "name",
                "text"
              ]
            }
          }
        },
        "rsvp": {
          "default": {},
          "type": "object",
          "properties": {
            "maxPax": {
              "default": 2,
              "type": "integer",
              "minimum": 1,
              "maximum": 20
