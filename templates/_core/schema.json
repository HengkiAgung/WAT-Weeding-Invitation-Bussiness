              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "time",
              "title"
            ]
          }
        },
        "gift": {
          "type": "object",
          "properties": {
            "accounts": {
              "default": [],
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "default": "bank",
                    "type": "string",
                    "enum": [
                      "bank",
                      "ewallet"
                    ]
                  },
                  "provider": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "number": {
                    "type": "string",
                    "pattern": "^[0-9 +\\-]{4,30}$"
                  },
                  "holder": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "required": [
                  "provider",
                  "number",
                  "holder"
                ]
              }
            },
            "qris": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
