            "deadline": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "askEvents": {
              "default": true,
              "type": "boolean"
            }
          }
        },
        "inviters": {
          "default": {},
          "type": "object",
          "properties": {
            "groom": {
              "default": [],
              "maxItems": 40,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "bride": {
              "default": [],
              "maxItems": 40,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        },
        "igFilter": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "maxLength": 500,
              "format": "uri"
            }
          },
          "required": [
            "url"
          ]
        },
        "dresscode": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 400
            },
            "colors": {
              "default": [],
              "maxItems": 6,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
