    "Sections": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "cover",
          "hero",
          "opening",
          "verse",
          "couple",
          "countdown",
          "events",
          "rundown",
          "live",
          "story",
          "gallery",
          "video",
          "gift",
          "rsvp",
          "wishes",
          "turutMengundang",
          "qrTicket",
          "igFilter",
          "dresscode",
          "protocol",
          "closing",
          "footer"
        ]
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "Runtime": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "preview",
            "demo",
            "live"
          ]
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]{3,60}$"
        },
        "endpoint": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "token": {
          "type": "string",
          "maxLength": 500
        },
        "brand": {
          "default": {
            "name": "Undangan Digital"
